SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Hides which mp3 is which song. Required for production and for Supabase.
# Any long random string; changing it renames every audio file.
AUDIO_KEY_SECRET=
# Cloudflare Turnstile site key (public). Empty = no captcha on the anonymous
# sign-in, fine for dev/local. The secret key goes only in the Supabase dashboard.
VITE_TURNSTILE_SITE_KEY=
# "true" plays rounds through the Vercel Functions in api/ (takes precedence
# over the Supabase variables above). Needs AUDIO_KEY_SECRET and
# ROUND_TOKEN_SECRET on the server.
VITE_ROUNDS_API=
# Server-only (Vercel Functions in api/). Never give these a VITE_ prefix.
# Shared Neon database; the heardle writes to public.subscribers (db/subscribers.sql).
DATABASE_URL=
# Cloudflare Turnstile secret key; required once deployed. Verifies /api/subscribe.
TURNSTILE_SECRET_KEY=
# Resend API key for the welcome email. Missing = subscriptions work, no email.
RESEND_API_KEY=
# Public Vercel Blob base for the mp3s and peaks.json (API mode only), no trailing
# slash needed: https://<store-id>.public.blob.vercel-storage.com/audio
VITE_AUDIO_BASE_URL=
# Script-only (npm run upload-audio). Never give it a VITE_ prefix.
BLOB_READ_WRITE_TOKEN=
