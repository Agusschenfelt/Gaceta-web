SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Hides which mp3 is which song. Required for production and for Supabase.
# Any long random string; changing it renames every audio file.
AUDIO_KEY_SECRET=
# Cloudflare Turnstile site key (public). Empty = no captcha on the anonymous
# sign-in, fine for dev/local. The secret key goes only in the Supabase dashboard.
VITE_TURNSTILE_SITE_KEY=
